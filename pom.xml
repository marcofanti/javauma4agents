<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.uma4agents</groupId>
  <artifactId>uma4agents-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>uma4agents (Java)</name>
  <description>Java port of the UMA-for-Agents lab</description>

  <modules>
    <module>lib/uma4a-common</module>
    <module>lib/uma4a-pep</module>
    <module>mcp/alice-vault</module>
    <module>services/alice-portal</module>
    <module>services/uma-as</module>
    <module>services/org-authority</module>
    <module>services/joint-tally</module>
    <module>services/xaa-broker</module>
    <module>services/uma-pep</module>
    <module>services/agent-operator</module>
    <module>lib/uma4a-agent</module>
    <module>clients/demo-driver</module>
    <module>clients/owner-cli</module>
    <module>clients/agent-shim</module>
  </modules>

  <properties>
    <java.version>26</java.version>
    <maven.compiler.release>26</maven.compiler.release>
    <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
    <mcp.version>2.2.0</mcp.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
